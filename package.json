{
  "name": "roe-power-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "telegram:webhook": "node --env-file=.dev.vars scripts/telegram-webhook.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "grammy": "^1.46.0",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node-fetch": "^2.6.13",
    "drizzle-kit": "0.31.11",
    "node-fetch": "^2.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
